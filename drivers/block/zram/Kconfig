	bool "oplus zram  optimization"
	depends on ZRAM
	default y
	help
	oplus zram optimization
#endif /*OPLUS_FEATURE_ZRAM_OPT*/

#ifdef OPLUS_FEATURE_ZRAM_WRITEBACK
